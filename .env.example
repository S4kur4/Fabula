# Set to true when the application is served behind HTTPS.
FABULA_SECURE_COOKIE=false

# Enable only when a trusted reverse proxy overwrites forwarded headers.
FABULA_TRUST_PROXY_HEADERS=false

FABULA_MAX_UPLOAD_MB=25

# Optional. By default, a 0600 secret is generated at var/secret.key.
# FABULA_SECRET_KEY=

# Optional Cloudflare Turnstile login protection. Configure both keys and hostnames together.
# FABULA_TURNSTILE_SITE_KEY=
# FABULA_TURNSTILE_SECRET_KEY=

# Comma-separated hostnames returned by Siteverify, without schemes or ports.
# FABULA_TURNSTILE_EXPECTED_HOSTNAMES=example.com,www.example.com

# Siteverify network timeout in seconds.
FABULA_TURNSTILE_TIMEOUT_SECONDS=5
